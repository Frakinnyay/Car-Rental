# Copy to server/.env and fill in. NEVER commit the real .env file.

# MongoDB connection string (Atlas or local), WITHOUT a database name.
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# local: mongodb://127.0.0.1:27017
MONGODB_URI=
# Database name (default: car-rental)
MONGODB_DB_NAME=

# Long random string (32+ chars required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# ImageKit (image hosting for car photos / profile pictures) - https://imagekit.io
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Allowed browser origin(s) for CORS, comma separated, no trailing slash.
# Required in production, e.g. https://your-client.vercel.app
CLIENT_URL=

PORT=3000
NODE_ENV=development

# Only for `npm run seed` (optional demo data)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
